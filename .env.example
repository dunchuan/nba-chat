DASHSCOPE_API_KEY=your_dashscope_api_key
MODEL_NAME=qwen3.7-plus
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_ENABLE_THINKING=false
MODEL_DYNAMIC_THINKING=true
REACT_MAX_STEPS=12
LANGGRAPH_RECURSION_LIMIT=40
SQLITE_PATH=./data/nba_chat.sqlite3
ROUTER_MODEL_NAME=qwen3.6-flash
# 客观事实/数据整理使用快速模型；复杂分析仍使用 MODEL_NAME。
FACTUAL_MODEL_NAME=qwen3.6-flash
FACTUAL_MAX_COMPLETION_TOKENS=500
PLAYER_STATS_MAX_COMPLETION_TOKENS=1800
LIGHT_ANALYSIS_MAX_COMPLETION_TOKENS=2000
ANALYSIS_MAX_COMPLETION_TOKENS=3000
RUN_LIVE_TESTS=false
TAVILY_API_KEY=tvly-your_tavily_api_key
# 默认展示：球员、球队、时间、得分、篮板、助攻。
BOX_SCORE_FIELDS=player_name,team,minutes,fgm,fga,fg_pct,fg3m,fg3a,fg3_pct,ftm,fta,ft_pct,oreb,dreb,reb,ast,stl,blk,tov,pf,pts,plus_minus

# Optional LangSmith tracing. Create an API key at https://smith.langchain.com/
# and set LANGSMITH_TRACING=true to inspect LangGraph node/tool/LLM runs.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=nba-chat-local
# LANGSMITH_API_KEY=lsv2_your_langsmith_api_key
